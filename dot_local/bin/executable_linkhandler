#!/usr/bin/env sh
# Credits: https://github.com/LukeSmithxyz/voidrice/blob/master/.local/bin/linkhandler

if [ -z "$1" ]; then
    url="$(wl-paste)"
else
    url="$1"
fi

queue () {
    if [[ ! -f /tmp/.mpvinput ]]; then
        touch /tmp/.mpvinput
    fi
    if pgrep -f MPV-Q > /dev/null; then
        echo "loadfile "$1" append-play" | socat - /tmp/.mpvinput
    else
        mpv --no-terminal --title=MPV-Q --input-ipc-server=/tmp/.mpvinput --idle=yes "$1" &
    fi
}

case "$url" in
    *mkv|*webm|*mp4|*youtube.com/watch*|*youtube.com/playlist*|*youtube.com/shorts*|*youtu.be*|*hooktube.com*|*bitchute.com*|*videos.lukesmith.xyz*|*odysee.com*)
	queue "$url" >/dev/null 2>&1 ;;
    *)
        [ -f "$url" ] && setsid -f "$TERMINAL" -e "$EDITOR" "$url" >/dev/null 2>&1 || setsid -f "$BROWSER" --new-tab --url "$url" >/dev/null 2>&1
esac
