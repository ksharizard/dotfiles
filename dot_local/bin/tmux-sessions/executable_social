#!/bin/bash
SESSION="social"

tmux has-session -t $SESSION 2>/dev/null
if [ $? != 0 ]; then
  tmux new-session -d -s $SESSION -n mail "neomutt; $SHELL"
  tmux new-window -t $SESSION:2 -n rss "newsboat; $SHELL"
  tmux new-window -t $SESSION:3 -n yt "yt-x; $SHELL"
  tmux new-window -t $SESSION:4 -n music "subtui; $SHELL"
fi
